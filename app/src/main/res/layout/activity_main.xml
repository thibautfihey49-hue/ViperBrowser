<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAAA">

    <!-- Barre de progression -->
    <ProgressBar
        android:id="@+id/page_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:progressTint="#007AFF"
        android:progressBackgroundTint="#E5E5E7"
        android:max="100"
        android:visibility="gone"/>

    <!-- Barre supérieure cachée sur page d'accueil -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:background="#FAFAAA"
        android:elevation="0dp"
        android:id="@+id/nav_bar"
        android:visibility="gone">

        <Button android:id="@+id/btn_back" android:text="◀"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/bg_btn_light" android:textColor="#1D1D1F"/>
        <Button android:id="@+id/btn_forward" android:text="▶"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/bg_btn_light" android:textColor="#1D1D1F" android:layout_marginStart="4dp"/>
        <EditText android:id="@+id/url_bar"
            android:layout_width="0dp" android:layout_height="42dp" android:layout_weight="1"
            android:hint="Rechercher ou entrer une URL"
            android:background="@drawable/bg_url_bar"
            android:paddingHorizontal="16dp" android:layout_marginStart="10dp"
            android:textColor="#1D1D1F" android:textColorHint="#86868B"
            android:inputType="textUri" android:singleLine="true" android:textSize="15sp"/>
        <TextView android:id="@+id/statut_secure" android:text="🔒"
            android:layout_width="wrap_content" android:layout_height="42dp"
            android:gravity="center" android:paddingHorizontal="8dp" android:textSize="14sp"/>
        <Button android:id="@+id/btn_private" android:text="🕶️"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/bg_btn_light" android:layout_marginStart="4dp"/>
        <Button android:id="@+id/btn_video" android:text="📹"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/bg_btn_light" android:layout_marginStart="4dp"/>
        <Button android:id="@+id/btn_cast" android:text="📺"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/bg_btn_light" android:layout_marginStart="4dp"/>
        <Button android:id="@+id/btn_dl_list" android:text="⬇"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/bg_btn_light" android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- PAGE D'ACCUEIL — Identique à la maquette -->
    <ScrollView
        android:id="@+id/home_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="100dp"
            android:paddingHorizontal="32dp">

            <!-- Titre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ViperBrowser"
                android:textSize="34sp"
                android:textStyle="bold"
                android:textColor="#1D1D1F"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rapide, léger et sécurisé"
                android:textSize="16sp"
                android:textColor="#86868B"
                android:layout_marginBottom="48dp"/>

            <!-- Barre de recherche style maquette -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#F5F5F7"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:layout_marginBottom="48dp"
                android:elevation="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍"
                    android:textSize="18sp"
                    android:layout_marginEnd="12dp"/>

                <EditText
                    android:id="@+id/home_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Rechercher ou entrer une URL"
                    android:textColor="#1D1D1F"
                    android:textColorHint="#86868B"
                    android:background="@null"
                    android:textSize="16sp"
                    android:inputType="textUri|textWebEditText"
                    android:singleLine="true"/>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings"
                    android:tint="#C7C7CC"/>
            </LinearLayout>

            <!-- Sites favoris — icônes dans le même thème -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Favoris"
                android:textSize="15sp"
                android:textStyle="normal"
                android:textColor="#1D1D1F"
                android:layout_marginBottom="16dp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="4"
                android:rowCount="2"
                android:layout_marginBottom="32dp">

                <!-- Google -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:gravity="center"
                    android:orientation="vertical" android:padding="8dp"
                    android:clickable="true" android:focusable="true"
                    android:id="@+id/fav_google">
                    <TextView android:text="G" android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_fav_icon"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:gravity="center" android:layout_marginBottom="8dp"/>
                    <TextView android:text="Google" android:textSize="12sp"
                        android:textColor="#1D1D1F"/>
                </LinearLayout>

                <!-- YouTube -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:gravity="center"
                    android:orientation="vertical" android:padding="8dp"
                    android:clickable="true" android:focusable="true"
                    android:id="@+id/fav_youtube">
                    <TextView android:text="▶" android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_fav_rouge"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:gravity="center" android:layout_marginBottom="8dp"/>
                    <TextView android:text="YouTube" android:textSize="12sp"
                        android:textColor="#1D1D1F"/>
                </LinearLayout>

                <!-- Wikipedia -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:gravity="center"
                    android:orientation="vertical" android:padding="8dp"
                    android:clickable="true" android:focusable="true"
                    android:id="@+id/fav_wikipedia">
                    <TextView android:text="W" android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:background="@drawable/bg_fav_gris"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:gravity="center" android:layout_marginBottom="8dp"/>
                    <TextView android:text="Wikipédia" android:textSize="12sp"
                        android:textColor="#1D1D1F"/>
                </LinearLayout>

                <!-- DuckDuckGo -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:gravity="center"
                    android:orientation="vertical" android:padding="8dp"
                    android:clickable="true" android:focusable="true"
                    android:id="@+id/fav_duck">
                    <TextView android:text="🦆" android:textSize="20sp"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:gravity="center" android:layout_marginBottom="8dp"
                        android:background="#DE5833"/>
                    <TextView android:text="DuckDuckGo" android:textSize="12sp"
                        android:textColor="#1D1D1F"/>
                </LinearLayout>

                <!-- Amazon -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:gravity="center"
                    android:orientation="vertical" android:padding="8dp"
                    android:clickable="true" android:focusable="true"
                    android:id="@+id/fav_amazon">
                    <TextView android:text="A" android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:background="#FF9900"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:gravity="center" android:layout_marginBottom="8dp"/>
                    <TextView android:text="Amazon" android:textSize="12sp"
                        android:textColor="#1D1D1F"/>
                </LinearLayout>

                <!-- Twitter/X -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:gravity="center"
                    android:orientation="vertical" android:padding="8dp"
                    android:clickable="true" android:focusable="true"
                    android:id="@+id/fav_x">
                    <TextView android:text="X" android:textSize="20sp"
                        android:textColor="#FFFFFF"
                        android:background="#000000"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:gravity="center" android:layout_marginBottom="8dp"/>
                    <TextView android:text="X" android:textSize="12sp"
                        android:textColor="#1D1D1F"/>
                </LinearLayout>

                <!-- GitHub -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:gravity="center"
                    android:orientation="vertical" android:padding="8dp"
                    android:clickable="true" android:focusable="true"
                    android:id="@+id/fav_github">
                    <TextView android:text="◆" android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:background="#333333"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:gravity="center" android:layout_marginBottom="8dp"/>
                    <TextView android:text="GitHub" android:textSize="12sp"
                        android:textColor="#1D1D1F"/>
                </LinearLayout>

                <!-- YouTube -->
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_columnWeight="1" android:gravity="center"
                    android:orientation="vertical" android:padding="8dp"
                    android:clickable="true" android:focusable="true"
                    android:id="@+id/fav_more">
                    <TextView android:text="+" android:textSize="22sp"
                        android:textColor="#86868B"
                        android:background="#E8E8ED"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:gravity="center" android:layout_marginBottom="8dp"/>
                    <TextView android:text="Plus" android:textSize="12sp"
                        android:textColor="#86868B"/>
                </LinearLayout>

            </GridLayout>

        </LinearLayout>
    </ScrollView>

    <!-- WebView caché au démarrage -->
    <WebView
        android:id="@+id/web_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"/>

    <!-- Barre téléchargement -->
    <LinearLayout
        android:id="@+id/dl_status_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/dl_name" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Téléchargement..." android:textColor="#1D1D1F" android:textSize="13sp"/>
            <TextView android:id="@+id/dl_speed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0 KB/s" android:textColor="#007AFF" android:textSize="12sp" android:textStyle="bold" android:layout_marginStart="8dp"/>
        </LinearLayout>
        <ProgressBar android:id="@+id/dl_progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
            android:progressTint="#007AFF" android:progressBackgroundTint="#E5E5E7"/>
    </LinearLayout>
</LinearLayout>
